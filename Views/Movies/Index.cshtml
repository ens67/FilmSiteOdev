@model IEnumerable<MovieArchiveApp.Models.Movie>

@{
    ViewData["Title"] = "Ana Sayfa - Film Listesi";
}

<h2 class="mb-4 text-warning"><i class="bi bi-collection-play"></i> Film Arşivi</h2>

<form asp-action="Index" method="get" class="row g-3 mb-4 bg-secondary p-3 rounded shadow-sm">
    <div class="col-md-4">
        <select name="movieGenre" class="form-select bg-dark text-white border-secondary">
            <option value="">Tüm Türler</option>
            @foreach (var genre in ViewBag.Genres)
            {
                <option value="@genre">@genre</option>
            }
        </select>
    </div>
    <div class="col-md-5">
        <input type="text" name="searchString" class="form-control bg-dark text-white border-secondary" placeholder="Film adı veya yönetmen ara...">
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-warning w-100 fw-bold">Ara / Filtrele</button>
    </div>
</form>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-3 mb-4">
            <div class="card h-100 shadow border-0 bg-secondary text-white rounded-3 overflow-hidden">
                @if (!string.IsNullOrEmpty(item.ImagePath))
                {
                    <img src="@item.ImagePath" class="card-img-top" alt="@item.Title" style="height: 350px; object-fit: cover;">
                }
                else
                {
                    <div class="bg-gradient text-white d-flex flex-column align-items-center justify-content-center" style="height: 350px; background: linear-gradient(45deg, #1f4068, #162447);">
                        <i class="bi bi-camera-reels fs-1 mb-2 text-muted"></i>
                        <span class="text-muted small">Afiş Yüklenmedi</span>
                    </div>
                }
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title text-warning fw-bold mb-2">@item.Title</h5>
                        <p class="card-text mb-1 small text-white-50"><strong>Yönetmen:</strong> @item.Director</p>
                        <p class="card-text mb-1 small text-white-50"><strong>Tür:</strong> @item.Genre</p>
                        <p class="card-text mb-2 small text-white-50"><strong>Yıl:</strong> @item.ReleaseYear</p>
                    </div>
                    <div class="pt-2 border-top border-dark d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-light">
                            <i class="bi bi-star-fill text-warning"></i> @item.Rating/10
                        </span>
                        <div>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-light me-1"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>