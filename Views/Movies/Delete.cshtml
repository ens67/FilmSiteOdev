@model MovieArchiveApp.Models.Movie

@{
    ViewData["Title"] = "Filmi Sil";
}

<div class="row justify-content-center">
    <div class="col-md-6 border p-4 rounded shadow bg-white text-center">
        <h4 class="text-danger mb-4">Bu filmi silmek istediğinize emin misiniz?</h4>
        <h3>@Model.Title</h3>
        <p class="text-muted">@Model.Director tarafından yönetilen @Model.Genre türündeki film kalıcı olarak silinecektir.</p>
        
        <form asp-action="Delete" class="mt-4">
            <input type="hidden" asp-for="Id" />
            <a asp-action="Index" class="btn btn-secondary me-2">Vazgeç</a>
            <button type="submit" class="btn btn-danger">Evet, Sil</button>
        </form>
    </div>
</div>